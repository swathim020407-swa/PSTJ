include <bits/stdc++.h>
using namespace std;

int marsExploration(string s) {
int changes = 0;

string expected = "SOS";

for (int i = 0; i < s.length(); i++) {
    if (s[i] != expected[i % 3]) {
        changes++;
    }
}

return changes;

}

int main() {
string s;
cin >> s;

cout << marsExploration(s) << endl;

return 0;

}
