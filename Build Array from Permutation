class Solution {
    public int[] buildArray(int[] nums) {

        // Create an array to store the answer
        int[] ans = new int[nums.length];

        // Visit every index
        for (int i = 0; i < nums.length; i++) {

            // Use nums[i] as an index into nums
            ans[i] = nums[nums[i]];
        }

        return ans;
    }
}
